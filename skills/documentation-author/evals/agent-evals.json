{
  "skill_name": "documentation-author",
  "evals": [
    {
      "id": "suggest-first",
      "fixture": "tests/fixtures/agent/suggest-first",
      "prompt": "Write a getting-started guide for this project.",
      "checks": {
        "skill": "documentation-author",
        "read": [
          "package.json"
        ],
        "must_match": [
          "(confirm|accept|correct|approve|shall I|should I)",
          "(docs/|README)"
        ],
        "writes_only": [],
        "no_skill": [
          "documentation-review"
        ]
      },
      "allow": {
        "write": [
          "README.md",
          "docs/**"
        ]
      }
    },
    {
      "id": "verified-write",
      "fixture": "tests/fixtures/agent/verified-write",
      "prompt": "Write a getting-started guide for new contributors at docs/getting-started.md. I confirm the audience (new contributors) and the location, so go ahead and write it. Check every command you include before you finish.",
      "allow": {
        "run": [
          "npm test",
          "node --test",
          "node --version",
          "npm --version"
        ],
        "write": [
          "docs/getting-started.md"
        ]
      },
      "checks": {
        "skill": "documentation-author",
        "read": [
          "package.json"
        ],
        "ran": [
          "(npm test|node --test)"
        ],
        "writes_only": [
          "docs/getting-started.md"
        ],
        "files": {
          "docs/getting-started.md": [
            "^# ",
            "npm test"
          ]
        },
        "no_skill": [
          "documentation-review"
        ]
      }
    },
    {
      "id": "near-miss-review",
      "fixture": "tests/fixtures/agent/suggest-first",
      "prompt": "Check this repository's README for problems. Don't change anything.",
      "allow": {
        "write": [
          "README.md",
          "docs/**"
        ]
      },
      "checks": {
        "skill": "documentation-review",
        "no_skill": [
          "documentation-author"
        ],
        "writes_only": []
      }
    }
  ]
}
