+router.get('/orders/:id', requireRole('customer'), async (req, res) => {
+  const [order] = await db.query(
+    'SELECT * FROM orders WHERE id = $1 AND customer_id = $2',
+    [req.params.id, req.user.id],
+  );
+  if (!order) return res.status(404).end();
+  res.json(order);
+});
